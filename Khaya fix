let activeTopic='general';
function identifyProblem(x){
if(/\b(bathroom|shower|bath|washroom)\b/.test(x)&&/\b(wet|damp|moist|peel\w*|smell\w*|mou?ld|stain\w*|leak\w*)\b/.test(x)&&/\b(wall|paint|smell|mou?ld|damp)\b/.test(x))return 'bathroomDamp';
if(/\b(gas smell|smell gas|gas leak|smell of gas|smells? like gas)\b/.test(x))return 'gas';
if(/\b(burning smell|smoke|sparks?|sparking|exposed wires?|electric shock|electrical|sockets?|plugs? sparking|power trips?|db box)\b/.test(x))return 'electric';
if(/\b(clean\w*|deep clean|mopp?\w*|scrubb?\w*|greasy|grease|sticky|dirt\w*|post.renovation|move.in|move.out)\b/.test(x))return 'cleaning';
if(/\b(sewage|blocked|blockage|clogged|clog|drain blocked|drainage|drains?)\b/.test(x)&&!/\b(roof|ceiling|gutter)\b/.test(x))return 'blocked';
if(/\b(sagging|bulging|structural|foundations?)\b|wall (is )?moving|crack\w*\W+(\w+\W+){0,3}walls?|walls?\W+(\w+\W+){0,3}crack/.test(x))return 'structure';
if(/\b(mou?ld|damp|stains?|stained|ceilings?|roof|water ?marks?|condensation)\b/.test(x))return 'moisture';
if(/\b(tiles?|tiled|grout|cracked floor|floor crack\w*)\b/.test(x))return 'tile';
if(/\b(burst pipes?|flood\w*|taps?|faucets?|pipes?|plumb\w*|leak\w*|dripping|drips?|toilets?|cisterns?|flush\w*|water running)\b/.test(x))return 'plumbing';
if(/\b(doors?|hinges?|locks?|locked|latch\w*)\b/.test(x))return 'door';
if(/\b(paint\w*|peeling|flaking)\b/.test(x))return 'paint';
return 'general';}
function getGuidance(){const p=document.getElementById('problem').value.trim(),r=document.getElementById('helpResult'),f=document.getElementById('followup');if(!p){r.textContent='Please describe the problem so I can suggest a safe next step.';r.classList.remove('hidden');f.classList.add('hidden');return;}activeTopic=identifyProblem(p.toLowerCase());showGuidance(activeTopic,p);}
function showGuidance(topic,description){activeTopic=topic;const g=guidance[topic],r=document.getElementById('helpResult'),f=document.getElementById('followup');r.innerHTML='<h3>'+safeText(g.title)+'</h3><p><strong>You described:</strong> '+safeText(description)+'</p><p>'+safeText(g.intro)+'</p><div class="notice"><strong>Safety first:</strong> If you notice smoke, gas, exposed electricity, a collapsing or sagging structure, sewage or severe flooding, keep clear and seek urgent professional help.</div>';r.classList.remove('hidden');if(g.urgent){f.innerHTML='<h3>What to do now</h3><p>'+safeText(g.steps)+'</p><p><strong>Professional help:</strong> '+safeText(g.pro)+'</p>'+helpActions();f.classList.remove('hidden');return;}f.innerHTML='<h3>A few questions to guide the next step</h3>'+g.questions.map((q,i)=>'<div class="question"><label for="follow'+i+'">'+safeText(q.label)+'</label><select id="follow'+i+'">'+q.options.map(([v,label])=>'<option value="'+safeText(v)+'">'+safeText(label)+'</option>').join('')+'</select></div>').join('')+'<button class="primary" type="button" onclick="answerFollowups()">Show my next steps</button><div id="nextSteps" class="help-step hidden" aria-live="polite"></div>';f.classList.remove('hidden');}
function answerFollowups(){const g=guidance[activeTopic],answers=g.questions.map((_,i)=>document.getElementById('follow'+i).value),next=g.next(answers),target=document.getElementById('nextSteps');target.innerHTML='<h3>What this could mean</h3><p>'+safeText(next.cause)+'</p><h3>Safe next steps</h3><p>'+safeText(next.steps)+'</p><h3>When to get help</h3><p>'+safeText(next.pro)+'</p>'+(next.switchTo?'<button type="button" class="secondary" id="continueTopic">Ask more specific questions →</button>':'')+helpActions()+'<p class="muted"><small>This is general guidance, not a confirmed diagnosis. Do not attempt unsafe repairs.</small></p>';target.classList.remove('hidden');if(next.switchTo){document.getElementById('continueTopic').onclick=()=>showGuidance(next.switchTo,document.getElementById('problem').value.trim());}target.scrollIntoView({behavior:'smooth',block:'nearest'});}
function helpActions(){return '<div class="actions"><button class="secondary" type="button" onclick="prepareHelpRequest()">Request professional help →</button></div>';}
