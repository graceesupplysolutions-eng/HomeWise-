<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#244c7a"><title>🏠 KhayaFix | Practical help for your home</title><meta name="description" content="Practical home repair guidance, quote checklists and home maintenance support in South Africa.">
<style>
:root{--blue:#244c7a;--pale:#edf4fb;--green:#4e8069;--ink:#243247;--muted:#5d6b7d;--line:#dce5ee}*{box-sizing:border-box}body{margin:0;background:#f6f8fb;color:var(--ink);font-family:Arial,Helvetica,sans-serif;line-height:1.55}header{background:var(--blue);color:#fff;padding:20px max(18px,calc((100% - 820px)/2))}.brand{font-size:25px;font-weight:700}.tagline{font-size:14px;opacity:.92;margin-top:3px}main{max-width:820px;margin:auto;padding:18px}.hero,.card,.panel{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px;margin-bottom:16px}.hero{padding:25px}.eyebrow{color:var(--green);font-weight:700;font-size:12px;letter-spacing:.08em}h1{font-size:clamp(28px,7vw,39px);line-height:1.15;margin:8px 0 12px}h2{font-size:23px;margin:0 0 10px}h3{margin:0 0 8px}p{margin:8px 0 14px}.muted,small{color:var(--muted)}button,input,textarea,select{font:inherit}button{cursor:pointer}.primary,.navcard{border:0;border-radius:10px;padding:12px 16px}.primary{background:var(--green);color:#fff;font-weight:700}.secondary{background:var(--pale);color:var(--blue);border:1px solid var(--line);border-radius:10px;padding:10px 13px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.navcard{text-align:left;background:#fff;border:1px solid var(--line);padding:17px;color:var(--ink);min-height:132px}.navicon{font-size:27px;display:block;margin-bottom:8px}.navcard strong{display:block}.navcard small{display:block;margin-top:5px;line-height:1.4}.hidden{display:none!important}.section-head{display:flex;align-items:center;gap:10px;margin-bottom:16px}input,textarea,select{width:100%;border:1px solid #cbd6e2;border-radius:9px;padding:12px;margin:6px 0 14px;background:#fff;color:var(--ink)}label{font-weight:700;font-size:14px;display:block}.category-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.category-button{border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:9px;padding:11px;text-align:left}.category-button.active{border-color:var(--green);background:var(--pale)}.notice{background:#fff7e6;border-left:4px solid #d69b24;border-radius:8px;padding:12px}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}a.action{display:inline-block;text-decoration:none;background:var(--blue);color:#fff;padding:11px 13px;border-radius:9px;font-weight:700}a.action.green{background:var(--green)}.photo{display:none;max-width:100%;max-height:260px;border-radius:10px;margin:4px 0 14px}footer{text-align:center;color:#6c7888;font-size:12px;padding:20px}.question{margin:14px 0}.question select{margin-bottom:4px}.help-step{background:var(--pale);border-radius:10px;padding:14px;margin:12px 0}.help-step ul{margin-bottom:4px}.help-result h3{margin-top:14px}.privacy{font-size:13px;color:var(--muted);background:var(--pale);border-radius:8px;padding:10px 12px;margin:0 0 14px}@media(max-width:440px){.grid,.category-list{grid-template-columns:1fr}.hero,.card,.panel{padding:17px}}
</style></head><body>
<header><div class="brand">🏠 KhayaFix</div><div class="tagline">Practical help for your home</div></header><main>
<section id="home"><div class="hero"><div class="eyebrow">A LITTLE MORE CONFIDENCE AT HOME</div><h1>Home problems? Start here.</h1><p>Clear, practical guidance for everyday home repairs, help understanding contractor quotes, and a simpler way to find support for your home.</p><button class="primary" type="button" onclick="showSection('fix')">Get started →</button><p class="muted"><small>Simple guidance · Built for mobile · South African homes</small></p></div><h2>What do you need help with?</h2><div class="grid"><button class="navcard" type="button" onclick="showSection('clean')"><span class="navicon">🧹</span><strong>Book a Clean</strong><small>Pick your home size and request a quote in one tap.</small></button><button class="navcard" type="button" onclick="showSection('fix')"><span class="navicon">🛠️</span><strong>Fix It</strong><small>Find safe first steps for common home problems.</small></button><button class="navcard" type="button" onclick="showSection('quote')"><span class="navicon">🧾</span><strong>Check a Quote</strong><small>Review the details before agreeing to repair work.</small></button><button class="navcard" type="button" onclick="showSection('ask')"><span class="navicon">📷</span><strong>Ask for Help</strong><small>Describe your problem and optionally choose a photo.</small></button><button class="navcard" type="button" onclick="showSection('find')"><span class="navicon">🔧</span><strong>Find Help</strong><small>Contact GRACE E SUPPLY SOLUTIONS for support.</small></button></div><div class="panel"><strong>Not sure where to start?</strong><p class="muted">Choose Ask for Help and describe what you can see, hear or smell. Never approach electrical, gas or structural hazards to take a photo.</p></div></section>
<section id="clean" class="hidden"><div class="section-head"><button class="secondary" type="button" onclick="showSection('home')">← Home</button><h2>🧹 Book a Clean</h2></div><div class="card"><p>Choose your clean and home size. Grace will confirm the price and availability.</p><label for="cleanType">Type of clean</label><select id="cleanType"><option value="">Please select</option><option>Standard home cleaning</option><option>Deep cleaning</option><option>Move-in cleaning</option><option>Move-out cleaning</option><option>Post-renovation cleaning</option></select><label for="cleanSize">Home size</label><select id="cleanSize"><option value="">Please select</option><option>Studio / bachelor</option><option>1 bedroom</option><option>2 bedrooms</option><option>3 bedrooms</option><option>4+ bedrooms</option><option>Office / other property</option></select><label for="cleanArea">Your area</label><input id="cleanArea" placeholder="e.g. Centurion"><label for="cleanDate">Preferred date (optional)</label><input id="cleanDate" type="date"><label for="cleanNotes">Anything else? (optional)</label><textarea id="cleanNotes" placeholder="Tell us about the property and cleaning needed"></textarea><p class="privacy">🔒 Your details are only shared when you tap WhatsApp or Email and send the message.</p><div class="actions"><button class="primary" type="button" onclick="sendCleanRequest('wa')">Send via WhatsApp</button><button class="secondary" type="button" onclick="sendCleanRequest('mail')">Send via Email</button></div><p id="cleanError" class="muted" aria-live="polite"></p></div></section>
<section id="fix" class="hidden"><div class="section-head"><button class="secondary" onclick="showSection('home')">← Home</button><h2>Fix It</h2></div><p>Search the 12 categories for practical first steps and safety notes.</p><label for="fixSearch">Search problems</label><input id="fixSearch" type="search" placeholder="Try: leaking tap, damp, toilet..." oninput="renderFixes()"><div id="fixCategories" class="category-list"></div><div id="fixDetail" class="panel"></div></section>
<section id="quote" class="hidden"><div class="section-head"><button class="secondary" onclick="showSection('home')">← Home</button><h2>Check a Quote</h2></div><div class="card"><p>Use this free preview to check whether key details are included. It cannot confirm whether a price is fair without local scope and material details.</p><p class="privacy">🔒 What you type here stays on your device. Nothing is sent or stored by KhayaFix.</p><label for="quoteWork">What work is being quoted?</label><textarea id="quoteWork" placeholder="Describe the repair or work"></textarea><label for="quotePrice">Quoted price (R)</label><input id="quotePrice" type="number" min="0" step="0.01" placeholder="e.g. 1500"><label for="quoteMaterials">Are materials included?</label><select id="quoteMaterials"><option value="unsure">Not sure</option><option value="yes">Yes</option><option value="no">No</option></select><label for="quoteLabour">Is labour listed separately?</label><select id="quoteLabour"><option value="unsure">Not sure</option><option value="yes">Yes</option><option value="no">No</option></select><button class="primary" onclick="checkQuote()">Show free preview</button><div id="quoteResult" class="panel hidden" aria-live="polite"></div></div><div class="card"><h3>Detailed assessment options</h3><p><strong>R29</strong> per assessment · <strong>R69</strong> for 3 assessments</p><p class="muted">These are proposed test prices. Online payment is not connected, so no payment can be taken here.</p><button class="secondary" onclick="askAssessment()">Ask about a detailed assessment</button></div></section>
<section id="ask" class="hidden"><div class="section-head"><button class="secondary" onclick="showSection('home')">← Home</button><h2>Ask for Help</h2></div><div class="card"><p>Describe what is happening. You can also select a photo to preview it on your device. This tool provides guided first steps, not an AI diagnosis.</p><p class="privacy">🔒 Your description and photo stay on your device. They are not analysed or uploaded.</p><label for="problem">Describe your home problem</label><textarea id="problem" placeholder="What happened? Where is it? When did it start?"></textarea><label for="problemPhoto">Choose a photo (optional)</label><input id="problemPhoto" type="file" accept="image/*" onchange="previewPhoto(event)"><img id="photoPreview" class="photo" alt="Selected photo preview"><p class="muted"><small>Do not approach exposed wires, gas leaks, unstable ceilings or other hazards to take a photo.</small></p><button class="primary" onclick="getGuidance()">Get guidance</button><div id="helpResult" class="panel hidden" aria-live="polite"></div><div id="followup" class="panel hidden" aria-live="polite"></div></div></section>
<section id="find" class="hidden"><div class="section-head"><button class="secondary" onclick="showSection('home')">← Home</button><h2>Find Help</h2></div><div class="card" style="border:2px solid var(--green)"><div class="eyebrow">IN-HOUSE SERVICE OPTION</div><h3>GRACE E SUPPLY SOLUTIONS</h3><p>Centurion and wider Gauteng. Painting, deep cleaning, move-in/move-out and post-renovation cleaning, renovations, repairs and general maintenance. Please confirm availability and scope before booking.</p><div class="actions"><a class="action green" href="tel:+27680743710">Call Grace</a><a class="action" href="https://wa.me/27680743710?text=Hello%20GRACE%20E%20SUPPLY%20SOLUTIONS%2C%20I%20need%20help%20with%20home%20maintenance." target="_blank" rel="noopener">WhatsApp Grace</a><a class="action" href="mailto:graceesupplysolutions@gmail.com?subject=Home%20maintenance%20enquiry">Email Grace</a></div><h3 style="margin-top:22px">Request a quote</h3><p class="privacy">🔒 Your details are only shared when you tap WhatsApp or Email and send the message. Grace E Supply Solutions will use them only to respond to your request.</p><label for="requestName">Your name (optional)</label><input id="requestName" placeholder="Your name"><label for="requestArea">Your area</label><input id="requestArea" placeholder="e.g. Centurion"><label for="requestWork">What work do you need?</label><textarea id="requestWork" placeholder="Describe the work and preferred timeframe"></textarea><div class="actions"><button class="primary" onclick="sendQuoteRequest('wa')">Send via WhatsApp</button><button class="secondary" onclick="sendQuoteRequest('mail')">Send via email</button></div></div><div class="panel"><strong>When to call a professional</strong><p>Electrical faults, gas smells, sewage, burst pipes, widening cracks, moving walls or sagging ceilings can be dangerous. Keep clear and seek qualified help. Leave the area if collapse, fire or immediate danger seems possible.</p></div></section>
</main><footer><strong>🏠 KhayaFix</strong><p>© 2026 KhayaFix. All rights reserved.</p><p>Developed by GRACE E SUPPLY SOLUTIONS. Website content, code, branding and design are protected. Unauthorised copying or commercial reuse is prohibited.</p><p>General guidance only; not a substitute for qualified inspection.</p></footer>
<script>
const sections=['home','clean','fix','quote','ask','find'];
function showSection(id){sections.forEach(s=>document.getElementById(s).classList.toggle('hidden',s!==id));window.scrollTo({top:0,behavior:'smooth'});if(id==='fix')renderFixes();}
const fixes=[
{name:'Leaking tap',icon:'🚰',steps:'Place a container under the drip. Notice whether water comes from the spout or handle. Turn off an isolation valve only if you can identify it safely; never force a stuck valve.',warning:'If the leak continues or the valve is stuck, contact a plumber.'},
{name:'Leaking pipe',icon:'🚿',steps:'Keep away from slippery floors. Shut off water only if the valve is safely accessible. Take a photo from a dry position.',warning:'Never touch electrical switches or appliances in a wet area.'},
{name:'Damp wall or mould',icon:'🧱',steps:'Note whether the damp worsens after rain or plumbing use. Ventilate if safe and look for visible leaks without opening the wall.',warning:'Do not paint over dampness before its cause is found. Avoid disturbing extensive mould.'},
{name:'Door not closing',icon:'🚪',steps:'Check for an obstruction and look for visibly loose hinges without forcing the door. Note where the door rubs.',warning:'If the frame is cracked or the door is unstable, keep clear and seek help.'},
{name:'Blocked drain',icon:'🚿',steps:'Stop adding water if the drain backs up. Do not mix drain-cleaning chemicals.',warning:'Keep away from sewage and call a plumber if wastewater backs up.'},
{name:'Roof or ceiling leak',icon:'🏠',steps:'Move belongings only if safe. Place a container under a small drip only if the ceiling is stable and there is no electrical hazard.',warning:'Do not climb onto a wet roof or stand under a sagging ceiling.'},
{name:'Electrical problem',icon:'⚡',steps:'Keep away from exposed wires, sparks, wet switches or damaged appliances. Keep children and pets away.',warning:'Do not attempt DIY electrical repairs. Contact a qualified electrician from a safe location.'},
{name:'Peeling paint',icon:'🎨',steps:'Check whether the surface is damp. Note whether it is indoors or outdoors and resolve moisture before repainting.',warning:'Avoid sanding old paint until you know what it contains.'},
{name:'Uneven paving',icon:'🧱',steps:'Avoid trip hazards and photograph the area from a safe position. Note whether water pools after rain.',warning:'Do not dig near buried services without checking their location.'},
{name:'Toilet keeps running',icon:'🚽',steps:'Notice whether water continues after flushing. Do not force the cistern lid or fittings.',warning:'If it overflows, use a shut-off valve only if safe; call a plumber if the water will not stop.'},
{name:'Cracked wall',icon:'🧱',steps:'Photograph the crack with a ruler for scale if safe. Note whether it is widening or near a door or window.',warning:'If a wall is bulging, moving or a crack is rapidly widening, leave the area and seek urgent professional help.'},
{name:'Cleaning & Home Care',icon:'🧹',steps:'For everyday stains, first identify the surface and check the product label. Test a suitable cleaner on a small hidden area. For move-in, move-out or post-renovation cleaning, start with a room-by-room checklist and keep dust away from occupied areas.',warning:'Never mix bleach with acids, ammonia or other cleaners. Avoid disturbing extensive mould, unknown powders or renovation dust; seek specialist advice when needed.'},
{name:'General maintenance',icon:'🛠️',steps:'Describe what is wrong, where it is, when it started and whether it is getting worse. Take photos only from a safe distance.',warning:'If unsure whether a repair is safe, do not attempt it; ask a qualified professional.'}
];
let selectedFix=0;
function showFix(i){const f=fixes[i];selectedFix=i;document.getElementById('fixDetail').innerHTML='<h3>'+f.icon+' '+f.name+'</h3><p>'+f.steps+'</p><div class="notice"><strong>Safety:</strong> '+f.warning+'</div>';}
function renderFixes(){const q=(document.getElementById('fixSearch').value||'').trim().toLowerCase(),list=document.getElementById('fixCategories'),detail=document.getElementById('fixDetail');list.innerHTML='';const matches=[];fixes.forEach((f,i)=>{if(!q||(f.name+' '+f.steps+' '+f.warning).toLowerCase().includes(q))matches.push(i);});if(!matches.length){list.innerHTML='<p>No match found. Try another word or use Ask for Help.</p>';detail.innerHTML='<strong>No problem selected</strong><p class="muted">Try another search word.</p>';return;}if(!matches.includes(selectedFix))selectedFix=matches[0];matches.forEach(i=>{const f=fixes[i],b=document.createElement('button');b.type='button';b.className='category-button'+(i===selectedFix?' active':'');b.textContent=f.icon+' '+f.name;b.onclick=()=>{showFix(i);renderFixes();};list.appendChild(b);});showFix(selectedFix);}
function checkQuote(){const work=document.getElementById('quoteWork').value.trim(),price=document.getElementById('quotePrice').value,materials=document.getElementById('quoteMaterials').value,labour=document.getElementById('quoteLabour').value,r=document.getElementById('quoteResult');if(!work){r.innerHTML='<p>Please describe the work in the quote first.</p>';r.classList.remove('hidden');return;}const items=['A clear description of the work','Labour and material costs','Materials and quantities','Start date and estimated completion','Whether cleanup, disposal and VAT are included','Warranty or workmanship terms'];r.innerHTML='<h3>Free quote checklist</h3><p><strong>Work:</strong> '+safeText(work)+'</p>'+(price?'<p><strong>Quoted amount:</strong> R'+safeText(price)+'</p>':'<p>No price entered yet.</p>')+'<p><strong>Materials included:</strong> '+(materials==='yes'?'Yes':materials==='no'?'No':'Not sure')+'<br><strong>Labour itemised:</strong> '+(labour==='yes'?'Yes':labour==='no'?'No':'Not sure')+'</p><p>Before agreeing, confirm:</p><ul>'+items.map(x=>'<li>'+x+'</li>').join('')+'</ul><p class="notice">This is a checklist, not a verified market-price comparison. Get another written quote for larger jobs.</p>';r.classList.remove('hidden');}
function askAssessment(){document.getElementById('requestWork').value='I would like a detailed quote assessment (R29 each / R69 for 3).';showSection('find');}
let previewUrl=null;
function previewPhoto(e){const f=e.target.files&&e.target.files[0],img=document.getElementById('photoPreview');if(previewUrl){URL.revokeObjectURL(previewUrl);previewUrl=null;}if(!f){img.style.display='none';img.removeAttribute('src');return;}if(!f.type.startsWith('image/')){alert('Please choose an image file.');e.target.value='';img.style.display='none';return;}previewUrl=URL.createObjectURL(f);img.src=previewUrl;img.style.display='block';}
const guidance={
moisture:{title:'Damp, mould or a ceiling stain',intro:'Mould or a brown stain usually indicates moisture. Possible causes include condensation, rain entering the roof or a plumbing leak. A photo alone cannot confirm the source.',questions:[{label:'Where is the problem?',options:[['ceiling','On the ceiling'],['wall','On a wall'],['other','Somewhere else']]},{label:'When does it seem worse?',options:[['rain','After rain'],['steam','After showers, cooking or humid weather'],['water','After water is used upstairs or nearby'],['unknown','I am not sure']]},{label:'What can you safely see?',options:[['sag','Ceiling sagging, bulging, dripping near electrics or feeling unstable'],['small','Small stain or patch with no obvious damage'],['large','Large or spreading mould patch'],['unknown','Not sure']]}],next(a){if(a[2]==='sag')return {cause:'Possible dangerous water damage',steps:'Keep out from beneath the affected ceiling and away from nearby electrical fittings. Do not touch or open the ceiling.',pro:'Urgent building maintenance or qualified professional; leave the affected area.'};if(a[1]==='rain')return {cause:'Rainwater entry may be contributing',steps:'Note whether the patch changes after rain and take a photo from a safe, dry position. Do not climb onto the roof or paint over the stain.',pro:'A roofing professional should inspect the source before repairs or repainting.'};if(a[1]==='water')return {cause:'A hidden plumbing leak may be contributing',steps:'Check only visible, safely accessible fixtures for drips. Avoid opening walls or ceilings. If an active leak is present, isolate water only if safe.',pro:'Contact a plumber or building maintenance; report it promptly if in a complex.'};if(a[1]==='steam')return {cause:'Condensation may be contributing',steps:'Improve ventilation if safe, use extraction fans where available and monitor whether moisture reduces. Do not dry-brush or disturb mould.',pro:a[2]==='large'?'Ask a qualified mould/remediation professional to assess the extent.':'Seek assessment if mould returns or the surface stays wet.'};return {cause:'The moisture source is still uncertain',steps:'Record when the stain appears, whether it changes after rain or water use, and whether the area remains damp. Avoid painting or scraping until the cause is understood.',pro:a[2]==='large'?'Arrange professional assessment of the extensive mould and moisture source.':'Arrange an inspection if the problem persists or grows.'};}},
 bathroomDamp:{title:'Bathroom dampness, peeling paint or unusual smell',intro:'Several symptoms together may point to hidden plumbing, failed waterproofing, condensation or mould. The cause cannot be confirmed from a description alone.',questions:[{label:'When does the wall seem wetter?',options:[['shower','After showering or bathing'],['rain','After rain'],['always','Most of the time'],['unknown','Not sure']]},{label:'What does the smell resemble?',options:[['musty','Musty or mouldy'],['sewage','Sewage or drains'],['gas','Gas or rotten eggs'],['other','Something else or unsure']]},{label:'Where is the peeling or dampness?',options:[['shower','Near the shower or bath'],['basin','Near a basin, toilet or pipe'],['outside','On an outside-facing wall'],['unknown','Not sure']]},{label:'Is there any immediate warning sign?',options:[['electric','Water near electricity'],['damage','Bulging wall, sagging ceiling or severe water damage'],['none','No obvious immediate danger'],['unknown','Not sure']]}],next(a){if(a[1]==='gas')return {cause:'Possible gas hazard; a smell cannot safely confirm its source',steps:'Leave the area. Do not use switches, flames or phones near the suspected source.',pro:'Contact emergency services or your gas supplier from a safe location.'};if(a[3]!=='none')return {cause:'Potentially unsafe water damage or an unconfirmed hazard',steps:'Keep clear of the affected area, especially electricity and unstable surfaces. Do not open the wall or ceiling.',pro:'Seek prompt qualified assessment; leave the affected area if it appears unstable.'};if(a[1]==='sewage')return {cause:'A drain or wastewater issue may be contributing',steps:'Avoid contact with wastewater. Note when the smell is strongest and do not mix drain chemicals.',pro:'Arrange a plumber to inspect the drainage and nearby plumbing.'};if(a[0]==='shower'||a[2]==='shower')return {cause:'Shower waterproofing, grout or a concealed pipe may be involved',steps:'Avoid soaking the affected area. Note whether dampness increases after showering. Do not paint over it or remove tiles yourself.',pro:'Ask a waterproofing or plumbing professional to locate the moisture source before repairs.'};if(a[0]==='rain')return {cause:'Rainwater penetration may be contributing',steps:'Record changes after rainfall; check visible surfaces from a safe position. Do not climb onto a roof.',pro:'Arrange a building or waterproofing inspection.'};return {cause:'Condensation, mould or a concealed leak may be involved',steps:'Ventilate safely and note whether the wall dries between uses. Do not scrape, sand or paint over damp or mouldy areas.',pro:'Arrange inspection if moisture or smell persists, spreads or returns.'};}},
plumbing:{title:'Water leak or plumbing issue',intro:'The priority is preventing water damage and avoiding electricity. The source may be a tap, pipe, toilet or hidden connection.',questions:[{label:'Where is the water?',options:[['tap','At a tap or under a sink'],['pipe','At a pipe or wall'],['toilet','At the toilet'],['unknown','Not sure']]},{label:'How serious is it?',options:[['drip','Slow drip'],['flow','Steady flow or pooling water'],['sewage','Dirty water or sewage backing up'],['unknown','Not sure']]},{label:'Is water near plugs, wires or electrical equipment?',options:[['yes','Yes or possibly'],['no','No'],['unknown','Not sure']]}],next(a){if(a[2]!=='no')return {cause:'Possible electrical danger from water',steps:'Do not enter pooled water or touch electrical switches, sockets or appliances in the affected area. Keep others away.',pro:'Get urgent qualified help from a safe location.'};if(a[1]==='sewage')return {cause:'Possible sewage backup',steps:'Stop using affected drains and avoid contact with wastewater. Do not mix drain chemicals.',pro:'Contact a plumber urgently.'};if(a[1]==='flow')return {cause:'Active leak needing prompt attention',steps:'If safely accessible from a dry area, turn off the appropriate water isolation valve. Move belongings only if safe.',pro:'Arrange prompt plumbing assistance.'};return {cause:'Small plumbing leak is possible',steps:'Put a container under the drip if safe. Note exactly where the water starts. Do not force valves or dismantle fittings.',pro:'Contact a plumber if the drip continues, worsens or comes from a concealed pipe.'};}},
tile:{title:'Cracked or loose tile',intro:'A cracked tile may be cosmetic, caused by impact, movement or moisture beneath the surface.',questions:[{label:'Where is the tile?',options:[['floor','Floor'],['wall','Wall'],['wet','Shower or wet area'],['unknown','Not sure']]},{label:'What is happening?',options:[['hair','A small hairline crack'],['sharp','Sharp, broken or loose pieces'],['many','Several tiles cracking or lifting'],['unknown','Not sure']]},{label:'Is the surface wet, bulging or moving?',options:[['yes','Yes'],['no','No'],['unknown','Not sure']]}],next(a){if(a[1]==='sharp')return {cause:'Broken tile creates an injury risk',steps:'Keep people and pets away from sharp edges. Avoid walking barefoot on the area; do not pry up loose pieces.',pro:'Arrange tile repair; urgent attention if pieces are falling from a wall.'};if(a[1]==='many'||a[2]==='yes')return {cause:'Movement or moisture beneath tiles is possible',steps:'Avoid using a wet-area surface if water may be entering behind tiles. Note whether cracks are spreading; do not simply grout over a moving surface.',pro:'A tiler or relevant building professional should assess the underlying cause.'};return {cause:'Possibly localised tile damage',steps:'Photograph the crack, monitor changes and avoid impact on the area. A replacement may be possible once the substrate is checked.',pro:'A tiler can advise on matching and replacing the tile.'};}},
door:{title:'Door or hinge problem',intro:'A door that sticks may be affected by an obstruction, loose hinges, moisture or frame movement.',questions:[{label:'What happens?',options:[['stick','Sticks or rubs'],['lock','Lock or latch will not work'],['loose','Hinge or door is loose'],['unknown','Not sure']]},{label:'Is the door or frame cracked or unstable?',options:[['yes','Yes'],['no','No'],['unknown','Not sure']]}],next(a){if(a[1]==='yes'||a[0]==='loose')return {cause:'Potentially unstable door or frame',steps:'Do not force or lift the door yourself. Keep clear if it may fall.',pro:'Arrange a carpenter or maintenance professional.'};return {cause:a[0]==='lock'?'Latch alignment or lock wear may be involved':'Hinge alignment, obstruction or swelling may be involved',steps:'Look for visible obstructions and note where the door rubs, without forcing it. Do not dismantle a security lock.',pro:'Ask a locksmith or maintenance professional if it continues.'};}},
structure:{title:'Crack, sagging or possible structural issue',intro:'Some cracks are minor, but movement, bulging and sagging require caution.',questions:[{label:'What can you see?',options:[['small','Small surface crack'],['wide','Widening or large crack'],['bulge','Bulging wall or sagging ceiling'],['unknown','Not sure']]},{label:'Has it changed recently?',options:[['yes','Yes'],['no','No'],['unknown','Not sure']]}],next(a){if(a[0]==='wide'||a[0]==='bulge'||(a[0]==='small'&&a[1]==='yes'))return {cause:'Possible structural movement',steps:'Keep clear of the affected area. Do not patch, drill into or attempt to support the structure.',pro:'Arrange urgent assessment by a qualified building or structural professional; leave if collapse seems possible.'};if(a[0]==='unknown')return {cause:'Not enough detail to judge',steps:'Keep clear of the area if anything looks like it is bulging, sagging or moving. Take a photo with a size reference from a safe position.',pro:'Arrange a building professional to inspect it if you cannot tell how serious it is.'};return {cause:'Probably a minor surface crack, but this is not confirmed',steps:'Take a dated photo with a size reference if safe and re-check it in a few weeks. Avoid covering it before the cause is known.',pro:'Seek a building professional if it grows, spreads or other movement appears (sticking doors, gaps at window frames).'};}},
paint:{title:'Peeling paint or surface damage',intro:'Peeling paint can result from dampness, poor preparation or ageing coatings.',questions:[{label:'Is the wall damp or stained?',options:[['yes','Yes'],['no','No'],['unknown','Not sure']]},{label:'Where is it?',options:[['inside','Indoors'],['outside','Outside'],['unknown','Not sure']]}],next(a){return {cause:a[0]==='yes'?'Moisture may be causing paint failure':'Surface preparation or coating wear may be involved',steps:a[0]==='yes'?'Find the moisture source before repainting. Do not scrape mouldy or damp surfaces.':'Check for loose coating without sanding or scraping old unknown paint, which may contain hazardous substances.',pro:'A painting or maintenance professional can assess safe preparation and repainting after any damp issue is resolved.'};}},
blocked:{title:'Blocked drain or toilet',intro:'A blockage may be local or affect the wider drainage system.',questions:[{label:'What is happening?',options:[['slow','Water drains slowly'],['back','Water or sewage backs up'],['toilet','Toilet will not flush properly'],['unknown','Not sure']]},{label:'Have drain chemicals been used?',options:[['yes','Yes'],['no','No'],['unknown','Not sure']]}],next(a){if(a[0]==='back')return {cause:'Drain or sewer backup',steps:'Stop using affected fixtures, keep away from wastewater and do not mix or add drain chemicals.',pro:'Call a plumber urgently.'};return {cause:'Possible local blockage',steps:'Stop adding water if it may overflow. Never mix drain chemicals; tell a plumber if any have been used.',pro:'Arrange plumbing assistance if it persists or worsens.'};}},
